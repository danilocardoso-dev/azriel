{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azriel",
  "version": "0.4.0",
  "identifier": "com.azriel.intelligence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AZRIEL // Personal Intelligence System",
        "width": 1600,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
